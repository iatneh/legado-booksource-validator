[
 {
  "bookSourceName": "示例书源·普通规则",
  "bookSourceUrl": "https://example.com",
  "bookSourceGroup": "示例分组",
  "bookSourceType": 0,
  "enabled": true,
  "enabledExplore": true,
  "searchUrl": "https://example.com/search?keyword={{key}}&page={{page}}",
  "ruleSearch": {
   "name": "class.title@text",
   "author": "class.author@text",
